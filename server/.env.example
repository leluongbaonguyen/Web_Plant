# ====================================================
# SUPABASE CLOUD DATABASE CONFIGURATION FOR RENDER & LOCAL
# ====================================================
# Lấy các thông số bên dưới từ Supabase Dashboard: 
# Project Settings -> API -> Project URL & Project API Keys (anon key hoặc service_role key)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Cổng khởi chạy Server (Render sẽ tự động gán PORT)
PORT=4000
